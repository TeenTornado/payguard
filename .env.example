PAYGUARD_ENV=TEST
DATABASE_URL=postgresql+asyncpg://payguard:payguard@localhost:5432/payguard
RAZORPAY_TEST_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_TEST_KEY_SECRET=REPLACE_ME
RAZORPAY_TEST_WEBHOOK_SECRET=REPLACE_ME
GATEWAY_MODE=EMULATE

# Analyzer: Gemini direct (primary — free tier, 8 rpm)
# Get key at: https://aistudio.google.com/app/apikey  (AIza... format)
PAYGUARD_LLM_PROVIDER=openai_compat
PAYGUARD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PAYGUARD_LLM_API_KEY=REPLACE_ME
PAYGUARD_LLM_MODEL=gemini-3.6-flash
PAYGUARD_LLM_RPM=8
PAYGUARD_LLM_TPM=200000
PAYGUARD_LLM_MAX_TOKENS=8192

# Generator: Groq direct (primary — free tier, 25 rpm)
# Get key at: https://console.groq.com/keys
PAYGUARD_GEN_PROVIDER=openai_compat
PAYGUARD_GEN_BASE_URL=https://api.groq.com/openai/v1
PAYGUARD_GEN_API_KEY=REPLACE_ME
GROQ_API_KEY=REPLACE_ME
PAYGUARD_GEN_MODEL=llama-3.3-70b-versatile
PAYGUARD_GEN_RPM=25
PAYGUARD_GEN_TPM=10000

# Last-resort fallback: OpenRouter (50 RPD unfunded — do not use as primary)
PAYGUARD_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
PAYGUARD_FALLBACK_API_KEY=REPLACE_ME
PAYGUARD_FALLBACK_MODEL=google/gemini-2.5-flash
PAYGUARD_FALLBACK_RPM=20
PAYGUARD_FALLBACK_TPM=20000

# Anthropic (legacy, kept for compatibility; leave empty if using openai_compat)
ANTHROPIC_API_KEY=

PAYGUARD_DEMO=0
SANDBOX_RUNTIME=docker
CONSOLE_BIND=127.0.0.1
GATEWAY_PORT=8001
API_PORT=8000
WEB_PORT=3000
